# Copy to .env and fill in. Never commit .env — it is gitignored.

# ── Required ────────────────────────────────────────────────────

# Signs session cookies. Must be 32+ characters.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=

# Who can sign in, as label:code pairs separated by commas.
# Give each person their own code so you can revoke one without
# disturbing the others. Codes must be 12+ characters.
# Generate one with:  openssl rand -hex 12
INVITE_CODES=you:replace-this-with-a-real-code,friend:another-real-code

# ── Server-side vision (optional) ───────────────────────────────

# gemini | huggingface | none
# "none" runs the app on-device only, which still fills in every field.
VISION_PROVIDER=none

# Only the one matching VISION_PROVIDER is needed.
GEMINI_API_KEY=
HF_TOKEN=

# Optional override for the Hugging Face model.
# HF_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# ── Deployment ──────────────────────────────────────────────────

PORT=8787
NODE_ENV=development

# Serve the built frontend from this server. Defaults to on in production.
# SERVE_STATIC=true
# STATIC_DIR=dist

# Session lifetime in seconds. Default is 30 days.
# SESSION_TTL_SECONDS=2592000

# Only enable behind a reverse proxy you control (Caddy, nginx, Fly, Railway).
# Enabling it without a proxy lets clients spoof their IP and dodge rate limits.
# TRUST_PROXY=false

# Extra origins allowed to call the API. Leave empty for same-origin only.
# ALLOWED_ORIGINS=https://looks.example.com
