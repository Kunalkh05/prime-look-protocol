{
  "name": "looksmax-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run setup:ort && vite",
    "dev:server": "node --experimental-strip-types --watch --env-file=.env server/index.ts",
    "setup:ort": "node scripts/copy-ort.mjs",
    "prebuild": "npm run setup:ort",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node --env-file=.env server-dist/index.js",
    "lint": "oxlint",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "hono": "^4.12.32"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@mediapipe/tasks-vision": "^0.10.14",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^3.2.7"
  }
}
